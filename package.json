{
  "name": "wall",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc -b && vite build && vite build --ssr src/core.ts --outDir dist-core",
    "start": "electron .",
    "app": "tauri dev",
    "app:electron": "npm run build && electron .",
    "app:bundle": "tauri build",
    "web": "vite",
    "verify": "npm run build && node verify.mjs",
    "verify:web": "npm run build && node verify-web.mjs",
    "verify:stream": "npm run build && node verify-stream.mjs",
    "capture": "npm run build && node capture.mjs",
    "verify:all": "npm run build && node verify.mjs && node verify-web.mjs && node verify-server.mjs && node verify-stream.mjs && node verify-stream.mjs fixtures/truncated && node verify-mcp.mjs && node verify-image.mjs && node verify-tauri.mjs",
    "verify:stream:truncated": "node verify-stream.mjs fixtures/truncated",
    "serve": "npm run build && node server/index.mjs",
    "verify:server": "npm run build && node verify-server.mjs",
    "mcp": "node mcp/index.mjs",
    "verify:mcp": "npm run build && node verify-mcp.mjs",
    "build:wasm": "node wasm.mjs",
    "verify:image": "node verify-image.mjs",
    "verify:tauri": "node verify-tauri.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "latest",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "type": "module"
}
