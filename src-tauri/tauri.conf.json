{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wall",
  "version": "0.1.0",
  "identifier": "inc.flits.wall",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wall",
        "width": 1520,
        "height": 980,
        "minWidth": 1080,
        "minHeight": 700,
        "backgroundColor": "#0a0b0d",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Wall",
    "category": "DeveloperTool",
    "shortDescription": "Eight landing pages, then one.",
    "longDescription": "Wall writes eight complete landing pages at once, each arguing a different case and built in a different visual world, and exports the one you pick as a single self contained HTML file."
  }
}
